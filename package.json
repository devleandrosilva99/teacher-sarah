{
  "name": "teacher-sarah",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/*.test.mts && npm run test:db",
    "test:db": "node --conditions=react-server --import tsx --test --test-concurrency=1 tests/db/*.test.mts",
    "db:migrate": "node scripts/migrate.mjs",
    "db:reset": "node scripts/migrate.mjs --reset && npm run db:seed",
    "db:seed": "node --conditions=react-server --import tsx scripts/seed.mts",
    "db:backup": "node scripts/backup.mjs",
    "db:app-login": "node scripts/app-login.mjs"
  },
  "dependencies": {
    "@vercel/blob": "2.8.2",
    "@vercel/functions": "^3.10.5",
    "lucide-react": "^1.16.0",
    "next": "16.4.3",
    "nodemailer": "10.1.7",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "4.6.7"
    }
  }
}
