# PostgreSQL (Neon). Para desenvolvimento, aponte para a branch dev do Neon.
# O app usa a conexão com pooler; migrações, seed, testes e backup usam a direta.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Recomendado. Conexão do app com o papel app_login (sem privilégios de dono),
# pelo pooler. Criada por `npm run db:app-login`, que grava o valor aqui sem
# mostrar a senha. Sem ela, o app usa DATABASE_URL (o dono) e avisa no log e
# no painel do admin. Migrações, seed, testes e backup continuam com o dono.
DATABASE_APP_URL=

# Conta de administrador, criada no primeiro acesso ao banco.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# false = começar sem as contas e dados de demonstração.
SEED_DEMO=true

# Opcional. Se vazio, um segredo aleatório é gerado e guardado no banco.
SESSION_SECRET=

# Opcional. Endereço público usado nos links de convite (ex.: https://seuapp.vercel.app).
APP_URL=

# Opcional. Pasta dos backups (npm run db:backup); precisa ficar fora do repositório.
BACKUP_DIR=

# Opcional. E-mail (recuperação de senha, confirmação, convites). Sem estas
# variáveis: no desenvolvimento local os e-mails vão para .data/outbox/ (veja
# /dev/emails); na Vercel nada é enviado e as telas avisam.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<conta>, SMTP_PASS=<senha de app>.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Opcional. Envio de arquivos (mídias das questões e entregas dos alunos) no
# Vercel Blob privado. Duas formas (o app usa a que existir; o token fixo
# tem preferência):
#   - OIDC, o padrão da Vercel ao ligar um store ao projeto: BLOB_STORE_ID e
#     BLOB_WEBHOOK_PUBLIC_KEY (criadas pela Vercel). O token OIDC de curta
#     duração vem em cada requisição na Vercel; fora dela, VERCEL_OIDC_TOKEN
#     (vercel env pull) é necessário;
#   - BLOB_READ_WRITE_TOKEN, um token fixo do store.
# Sem nenhuma: no desenvolvimento local os arquivos vão para .data/uploads/;
# na Vercel o envio de arquivos fica desativado com aviso.
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
BLOB_READ_WRITE_TOKEN=
